{
  "name": "@offrouter/mcp",
  "version": "0.1.0",
  "description": "MCP server for OffRouter private inference. Every model runs in a GPU TEE, and your prompts are encrypted to the enclave before they leave your machine.",
  "license": "MIT",
  "author": "OffRouter",
  "homepage": "https://offrouter.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offrouter/mcp.git"
  },
  "bugs": "https://github.com/offrouter/mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "private-inference",
    "tee",
    "confidential-computing",
    "x402",
    "llm"
  ],
  "type": "module",
  "bin": {
    "offrouter-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@phala/aci-verifier": "^0.8.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "viem": "^2.55.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
